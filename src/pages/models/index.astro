---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Filter from '../../components/Filter.astro';
import { MODEL_GROUPS } from '../../taxonomy';
import { href } from '../../lib';
import { MODEL_CHIPS, modelCard } from '../../cards';

type T = Record<string, { label: string; desc: string }>;
const all = (await getCollection('models')).sort((a, b) => +b.data.releaseDate - +a.data.releaseDate);
const groups = Object.entries(MODEL_GROUPS).map(([gid, g]) => ({
  id: gid, ...g,
  types: Object.entries(g.types as T).map(([tid, t]) => ({ id: tid, ...t, items: all.filter((m) => m.data.type === tid) })),
}));
---
<Base title="오픈 웨이트 모델" current="models" description="오픈 웨이트 모델을 용도·모달리티·판단형 여부로 분류">
  <div class="page-head">
    <h1>오픈 웨이트 모델<span class="count-pill">{all.length}</span></h1>
    <p>모델마다 주 분류를 하나만 붙이고, 추론 방식·입력 모달리티·크기·라이선스는 필터로 고릅니다. 규칙은 <a href={href('taxonomy/')}>분류 기준</a>에.</p>
  </div>
  <div class="directory">
    <aside class="sidebar" aria-label="모델 분류">
      {groups.map((g) => (
        <>
          <div class="label">{g.label}</div>
          {g.types.map((t) => t.items.length
            ? <a href={href(`models/type/${t.id}/`)}>{t.label} <span>{t.items.length}</span></a>
            : <span class="off">{t.label} <span>0</span></span>)}
        </>
      ))}
    </aside>
    <div>
      <Filter chips={MODEL_CHIPS} placeholder="모델명, 조직, 용도로 검색" />
      {groups.flatMap((g) => g.types.filter((t) => t.items.length).map((t) => (
        <section class="section" id={t.id} data-section>
          <div class="section-head">
            <h2>{g.label} · {t.label}</h2><span class="count" data-count>{t.items.length}</span>
            <a class="more" href={href(`models/type/${t.id}/`)}>이 분류만 보기 →</a>
          </div>
          <p class="section-desc">{t.desc}</p>
          <div class="grid">{t.items.map((e) => <Card {...modelCard(e)} />)}</div>
        </section>
      )))}
    </div>
  </div>
</Base>
