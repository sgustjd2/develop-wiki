---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { KNOWLEDGE } from '../../taxonomy';
import { href } from '../../lib';
import { knowledgeCard } from '../../cards';

const all = (await getCollection('knowledge')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));
const cats = Object.entries(KNOWLEDGE).map(([id, c]) => ({ id, ...c, items: all.filter((e) => e.data.category === id) }));
---
<Base title="개발 지식" current="knowledge" description="디자인 패턴, 아키텍처, 설계 원칙 등 개발에 중요한 지식 정리">
  <div class="page-head">
    <h1>개발 지식<span class="count-pill">{all.length}</span></h1>
    <p>디자인 패턴, 아키텍처, 설계 원칙, 분산 시스템처럼 도구가 바뀌어도 남는 지식을 원전과 공식 문서를 근거로 정리합니다.</p>
  </div>
  <div class="directory">
    <aside class="sidebar" aria-label="지식 분류">
      <div class="label">분류</div>
      {cats.map((c) => c.items.length
        ? <a href={href(`knowledge/${c.id}/`)}>{c.label} <span>{c.items.length}</span></a>
        : <span class="off">{c.label} <span>0</span></span>)}
    </aside>
    <div>
      {cats.filter((c) => c.items.length).map((c) => (
        <section class="section" id={c.id}>
          <div class="section-head">
            <h2>{c.label}</h2><span class="count">{c.items.length}</span>
            <a class="more" href={href(`knowledge/${c.id}/`)}>전체 보기 →</a>
          </div>
          <p class="section-desc">{c.desc}</p>
          <div class="grid">{c.items.slice(0, 6).map((e) => { const { search, facets, ...p } = knowledgeCard(e); return <Card {...p} />; })}</div>
        </section>
      ))}
    </div>
  </div>
</Base>
