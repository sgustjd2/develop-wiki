---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ARCHITECTURES, COMMERCIAL, KOREAN, MODEL_GROUPS, MODEL_TYPE_TO_GROUP, THINKING, modelTypeLabel } from '../../taxonomy';
import { fmtDate, href, hostOf, sourceUrl } from '../../lib';

export async function getStaticPaths() {
  return (await getCollection('models')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const group = MODEL_GROUPS[MODEL_TYPE_TO_GROUP[d.type]];
const blocks = [
  { title: '이럴 때 쓴다', xs: d.useCases },
  { title: '강점', xs: d.strengths },
  { title: '한계·주의', xs: d.limitations },
].filter((b) => b.xs.length);
---
<Base title={d.name} description={d.summary} current="models">
  <div class="article">
    <article class="article-main">
      <p class="crumbs"><a href={href('models/')}>오픈 웨이트 모델</a> / {group.label} / <a href={href(`models/type/${d.type}/`)}>{modelTypeLabel(d.type)}</a></p>
      <h1>{d.name}</h1>
      <p class="lead">{d.summary}</p>
      <div class="prose">
        {blocks.map((b) => (<><h2>{b.title}</h2><ul>{b.xs.map((x) => <li>{x}</li>)}</ul></>))}
        <Content />
        <h2>출처</h2>
        <ul>{d.sources.map((s) => <li><a href={s} target="_blank" rel="noopener">{hostOf(s)}</a> <code>{s.replace(/^https?:\/\//, '')}</code></li>)}</ul>
      </div>
    </article>
    <aside class="article-side">
      <dl class="facts">
        <dt>조직</dt><dd>{d.org}{d.family && ` · ${d.family}`}</dd>
        <dt>분류</dt><dd>{group.label} › {modelTypeLabel(d.type)}</dd>
        <dt>추론</dt><dd>{THINKING[d.thinking as keyof typeof THINKING]}</dd>
        <dt>입력→출력</dt><dd>{d.modalities.input.join(', ')} → {d.modalities.output.join(', ')}</dd>
        <dt>구조</dt><dd>{ARCHITECTURES[d.architecture as keyof typeof ARCHITECTURES]}</dd>
        {d.paramsB && (<><dt>파라미터</dt><dd>{d.paramsB}B{d.activeParamsB && ` (활성 ${d.activeParamsB}B)`}</dd></>)}
        {d.contextLength && (<><dt>컨텍스트</dt><dd>{d.contextLength.toLocaleString()} 토큰</dd></>)}
        <dt>라이선스</dt><dd>{d.license}<br />{COMMERCIAL[d.commercialUse as keyof typeof COMMERCIAL]}</dd>
        <dt>한국어</dt><dd>{KOREAN[d.korean as keyof typeof KOREAN]}</dd>
        <dt>공개일</dt><dd>{fmtDate(d.releaseDate)}</dd>
        {d.capabilities.length > 0 && (<><dt>기능</dt><dd>{d.capabilities.join(', ')}</dd></>)}
        <dt>검증일</dt><dd>{fmtDate(d.verifiedAt)}</dd>
      </dl>
      <div class="side-links">
        {d.huggingface && <a class="btn primary" href={d.huggingface} target="_blank" rel="noopener">Hugging Face ↗</a>}
        <a class="btn" href={sourceUrl('models', entry.id)} target="_blank" rel="noopener">Markdown 원문</a>
        <a class="btn" href={href('data/models.json')}>JSON 데이터</a>
      </div>
    </aside>
  </div>
</Base>
