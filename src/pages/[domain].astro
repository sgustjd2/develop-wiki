---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Filter from '../components/Filter.astro';
import { DOMAINS, DOMAIN_IDS, LANGUAGES, PRICING, type DomainId } from '../taxonomy';
import { hostOf } from '../lib';

export function getStaticPaths() {
  return DOMAIN_IDS.map((domain) => ({ params: { domain } }));
}

const domain = Astro.params.domain as DomainId;
const meta = DOMAINS[domain];
const all = (await getCollection('resources', (e) => e.data.domain === domain)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const sections = Object.entries(meta.categories as Record<string, { label: string; desc: string }>)
  .map(([id, c]) => ({ id, ...c, items: all.filter((e) => e.data.category === id) }))
  .filter((s) => s.items.length > 0);

const chips = [
  ...Object.entries(PRICING).map(([k, label]) => ({ facet: `pricing:${k}`, label })),
  { facet: 'ko:yes', label: '한국어 자료' },
  // 이 도메인에 실제로 쓰인 언어만 칩으로
  ...Object.entries(LANGUAGES)
    .filter(([k]) => all.some((e) => e.data.languages.includes(k)))
    .map(([k, label]) => ({ facet: `lang:${k}`, label })),
];
---
<Base title={meta.label} description={meta.desc} current={domain}>
  <div class="page-head">
    <h1>{meta.label} <span class="meta">{all.length}</span></h1>
    <p>{meta.desc}</p>
  </div>
  <div class="directory">
    <aside class="sidebar" aria-label="카테고리">
      <div class="label">카테고리</div>
      {sections.map((s) => <a href={`#${s.id}`}>{s.label} <span>{s.items.length}</span></a>)}
    </aside>
    <div>
      <Filter chips={chips} />
      {sections.map((s) => (
        <section class="section" id={s.id} data-section>
          <div class="section-head"><h2>{s.label}</h2><span class="count" data-count>{s.items.length}</span></div>
          <p class="section-desc">{s.desc}</p>
          <div class="grid">
            {s.items.map(({ data: d }) => (
              <a
                class="card"
                href={d.url}
                target="_blank"
                rel="noopener"
                data-item
                data-search={[d.name, d.description, ...d.tags].join(' ').toLowerCase()}
                data-facets={[`pricing:${d.pricing}`, `ko:${d.koreanDocs ? 'yes' : 'no'}`, ...d.languages.map((l) => `lang:${l}`)].join(' ')}
              >
                <span class="title">{d.name}</span>
                <span class="host">{hostOf(d.url)}</span>
                <span class="desc">{d.description}</span>
                <span class="badges">
                  <span class="badge">{PRICING[d.pricing as keyof typeof PRICING]}</span>
                  {d.languages.map((l) => <span class="badge strong">{LANGUAGES[l as keyof typeof LANGUAGES]}</span>)}
                  {d.koreanDocs && <span class="badge">한국어</span>}
                  {d.tags.map((t) => <span class="badge">#{t}</span>)}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
