---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { KNOWLEDGE, LEVELS } from '../../taxonomy';
import { fmtDate, href, hostOf } from '../../lib';

export async function getStaticPaths() {
  const all = await getCollection('knowledge');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cat = KNOWLEDGE[d.category as keyof typeof KNOWLEDGE];
const related = all.filter((e) => d.related.includes(e.id));
---
<Base title={d.title} description={d.summary} current="knowledge">
  <article class="detail prose">
    <p class="meta"><a href={href('knowledge/')}>개발 지식</a> / {cat.label} · {LEVELS[d.level as keyof typeof LEVELS]} · {fmtDate(d.updatedAt)}</p>
    <h1>{d.title}</h1>
    {d.aka.length > 0 && <p class="meta">{d.aka.join(' · ')}</p>}
    <p style="margin-top:12px">{d.summary}</p>
    <Content />
    {related.length > 0 && (
      <>
        <h2>관련 노트</h2>
        <ul>{related.map((r) => <li><a href={href(`knowledge/${r.id}/`)}>{r.data.title}</a></li>)}</ul>
      </>
    )}
    <h2>출처</h2>
    <ul>{d.sources.map((s) => <li><a href={s} target="_blank" rel="noopener">{hostOf(s)}</a></li>)}</ul>
  </article>
</Base>
