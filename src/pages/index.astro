---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { DOMAINS, DOMAIN_IDS, LANGUAGES, MODEL_GROUPS } from '../taxonomy';
import { href } from '../lib';
import { modelCard, resourceCard } from '../cards';

const resources = await getCollection('resources');
const models = await getCollection('models');
const knowledge = await getCollection('knowledge');
const strip = <T extends { search?: string; facets?: string }>({ search, facets, ...p }: T) => p;

const hubs = [
  ...DOMAIN_IDS.map((id) => ({
    path: `${id}/`, label: DOMAINS[id].label, desc: DOMAINS[id].desc,
    n: resources.filter((r) => r.data.domain === id).length,
  })),
  { path: 'models/', label: '오픈 웨이트 모델', desc: Object.values(MODEL_GROUPS).map((g) => g.label).join(' · '), n: models.length },
  { path: 'languages/', label: '개발 언어', desc: Object.values(LANGUAGES).slice(0, 8).join(' · ') + ' …', n: Object.keys(LANGUAGES).length },
  { path: 'knowledge/', label: '개발 지식', desc: '디자인 패턴 · 아키텍처 · 설계 원칙 · 분산 시스템', n: knowledge.length },
];
const latestModels = [...models].sort((a, b) => +b.data.releaseDate - +a.data.releaseDate).slice(0, 3);
const latestResources = [...resources].sort((a, b) => +b.data.addedAt - +a.data.addedAt).slice(0, 3);
---
<Base>
  <div class="page-head">
    <h1>개발자를 위한 백과사전</h1>
    <p>프론트엔드·백엔드·AI 기술, 오픈 웨이트 모델, 개발 언어와 설계 지식을 공식 문서 기반으로 정리하고 매일 갱신합니다.</p>
  </div>
  <div class="hub-grid">
    {hubs.map((c) => (
      <a class="card" href={href(c.path)}>
        <span class="num">{c.n}</span>
        <span class="title">{c.label}</span>
        <span class="desc">{c.desc}</span>
      </a>
    ))}
  </div>
  <section class="section">
    <div class="section-head"><h2>최근 공개된 모델</h2><a class="more" href={href('new/')}>새로 나온 것 전체 →</a></div>
    <div class="grid" style="margin-top:16px">{latestModels.map((e) => <Card {...strip(modelCard(e))} />)}</div>
  </section>
  <section class="section">
    <div class="section-head"><h2>새로 추가된 도구</h2><a class="more" href={href('new/')}>전체 →</a></div>
    <div class="grid" style="margin-top:16px">{latestResources.map((e) => <Card {...strip(resourceCard(e))} />)}</div>
  </section>
</Base>
