---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { DOMAINS, DOMAIN_IDS, LANGUAGES, type LanguageId } from '../../taxonomy';
import { fmtDate, href, hostOf, sourceUrl } from '../../lib';
import { resourceCard } from '../../cards';

export async function getStaticPaths() {
  const docs = await getCollection('languages');
  return Object.keys(LANGUAGES).map((lang) => ({ params: { lang }, props: { doc: docs.find((d) => d.id === lang) } }));
}
const lang = Astro.params.lang as LanguageId;
const { doc } = Astro.props;
const rendered = doc ? await render(doc) : undefined;
const d = doc?.data;
const TYPING = { static: '정적 타입', dynamic: '동적 타입', gradual: '점진적 타입' };
const EXEC = { compiled: '네이티브 컴파일', interpreted: '인터프리터', jit: 'JIT', vm: 'VM 바이트코드', transpiled: '트랜스파일' };

const all = (await getCollection('resources', (e) => e.data.languages.includes(lang))).sort((a, b) => a.data.name.localeCompare(b.data.name));
const sections = DOMAIN_IDS.map((id) => ({ id, label: DOMAINS[id].label, items: all.filter((e) => e.data.domain === id) })).filter((s) => s.items.length);
---
<Base title={LANGUAGES[lang]} description={d?.summary} current="languages">
  <div class="article">
    <article class="article-main">
      <p class="crumbs"><a href={href('languages/')}>개발 언어</a> /</p>
      <h1>{d?.name ?? LANGUAGES[lang]}</h1>
      {d && <p class="lead">{d.summary}</p>}
      <div class="prose">
        {rendered ? <rendered.Content /> : <p class="notice">아직 언어 개요가 없습니다. 에이전트가 공식 문서를 조사해 채웁니다.</p>}
        {d && (<><h2>출처</h2><ul>{d.sources.map((s) => <li><a href={s} target="_blank" rel="noopener">{hostOf(s)}</a></li>)}</ul></>)}
      </div>
      {sections.map((s) => (
        <section class="section" style="margin-top:48px">
          <div class="section-head"><h2>{s.label} 도구</h2><span class="count">{s.items.length}</span></div>
          <div class="grid" style="margin-top:16px">{s.items.map((e) => { const { search, facets, ...p } = resourceCard(e); return <Card {...p} />; })}</div>
        </section>
      ))}
    </article>
    <aside class="article-side">
      {d && (
        <dl class="facts">
          <dt>타입</dt><dd>{TYPING[d.typing]}</dd>
          <dt>실행</dt><dd>{EXEC[d.execution]}</dd>
          {d.paradigms.length > 0 && (<><dt>패러다임</dt><dd>{d.paradigms.join(', ')}</dd></>)}
          <dt>등장</dt><dd>{d.firstAppeared}</dd>
          <dt>주 용도</dt><dd>{d.useCases.join(', ')}</dd>
          <dt>갱신일</dt><dd>{fmtDate(d.updatedAt)}</dd>
        </dl>
      )}
      <div class="side-links">
        {d && <a class="btn primary" href={d.docs} target="_blank" rel="noopener">공식 문서 ↗</a>}
        {d && <a class="btn" href={d.officialSite} target="_blank" rel="noopener">{hostOf(d.officialSite)} ↗</a>}
        {doc && <a class="btn" href={sourceUrl('languages', doc.id)} target="_blank" rel="noopener">Markdown 원문</a>}
      </div>
    </aside>
  </div>
</Base>
