---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { LANGUAGES } from '../../taxonomy';
import { languagePath } from '../../lib';

const resources = await getCollection('resources');
const docs = await getCollection('languages');
const langs = Object.entries(LANGUAGES).map(([id, label]) => {
  const doc = docs.find((d) => d.id === id);
  const n = resources.filter((e) => e.data.languages.includes(id)).length;
  return { id, label, n, summary: doc?.data.summary };
});
---
<Base title="개발 언어" current="languages" description="개발 언어별 백과사전과 도구 모음">
  <div class="page-head">
    <h1>개발 언어<span class="count-pill">{langs.length}</span></h1>
    <p>언어마다 특징·주 용도·공식 문서를 정리하고, 그 언어로 쓰는 프레임워크·라이브러리를 프론트엔드·백엔드·AI 구분 없이 모읍니다.</p>
  </div>
  <div class="grid">
    {langs.map((l) => (
      <Card href={languagePath(l.id)} title={l.label} desc={l.summary ?? '언어 개요 준비 중'} badges={[{ label: `도구 ${l.n}개`, strong: l.n > 0 }]} />
    ))}
  </div>
</Base>
